# FS-ASM Runtime v1  example environment (no secrets committed)
# Copy to .env and fill only the values you need. This file is in .gitignore.

# --- Mistral Workflows connectivity (Temporal server) ---
# Required only when running the Temporal worker (``python -m entrypoints.worker``).
# The SDK reads these automatically; do NOT commit real credentials.
# MISTRAL_WORKFLOWS_HOST: URL of the Temporal server (default: http://localhost:7242)
# MISTRAL_API_KEY: Workflows API key (Temporal auth).
#
# Example (local dev):
# MISTRAL_WORKFLOWS_HOST=http://localhost:7242
# MISTRAL_API_KEY=your-temporal-api-key

# --- FS-ASM product settings ---
# FSASM_INCLUDE_HISTORICAL=1: opt-in to register legacy milestone demonstrators
#   (M1-M4, hello) in the worker. Default (empty/unset) excludes them.
#   Use only for research; NOT the product path.
FSASM_INCLUDE_HISTORICAL=

# --- Runtime paths (CLI overrides via --runs-dir / --workspace-root) ---
# Defaults used by ``python -m fsasm.cli`` commands if not passed on CLI:
#   runs_dir: ./runtime/runs
#   workspace_root: <cwd>
# Uncomment to override via environment:
# FSASM_RUNS_DIR=./my-runs
# FSASM_WORKSPACE_ROOT=./my-workspace

# --- Local model inference (laptop integration, Part II) ---
# Set when running with a real local adapter (T19/T29). Empty = stub only.
# FSASM_LOCAL_MODEL_ENDPOINT=http://localhost:1234
# FSASM_LOCAL_MODEL_API_KEY=

# --- Mistral API roles (T20/T21, Part II) ---
# Configure role-specific keys for Planner/API_A/API_B (T29). Empty = stub only.
# FSASM_MISTRAL_API_KEY=
